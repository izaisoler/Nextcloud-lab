# Configuración común (sin contraseñas: esas se generan solas en el paso 01)
NC_VERSION="32.0.15"          # 32 es compatible con PHP 8.1 (Ubuntu 22.04)
NC_DIR="/var/www/nextcloud"
DATA_DIR="/var/nextcloud-data"
ALIAS="/nextcloud"
PUBLIC_HOST="localhost:8080"  # host:puerto con el que entras desde tu PC
DB_NAME="nextcloud"
DB_USER="ncuser"
ADMIN_USER="admin"
BACKUP_DIR="/var/backups/nextcloud"
RETENTION_DAYS=7
